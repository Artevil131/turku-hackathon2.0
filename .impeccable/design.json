  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "description": "The main action in a task.",
      "html": "<button class=\"ds-primary\">Check now</button>",
      "css": ".ds-primary{font:600 18px/1.3 system-ui;min-height:48px;padding:10px 18px;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:var(--accent-text)}.ds-primary:hover{filter:brightness(.93)}.ds-primary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "description": "A non-primary choice.",
      "html": "<button class=\"ds-secondary\">Not now</button>",
      "css": ".ds-secondary{font:600 18px/1.3 system-ui;min-height:48px;padding:10px 18px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--text)}.ds-secondary:hover{filter:brightness(.93)}.ds-secondary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Source switch",
      "kind": "input",
      "description": "A labelled source permission switch.",
      "html": "<button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Calendar\"></button>",
      "css": ".ds-switch{position:relative;width:56px;height:44px;padding:0;border:0;background:transparent}.ds-switch:before{content:\"\";position:absolute;inset:6px 0;border:1px solid var(--selected-text);border-radius:20px;background:var(--selected)}.ds-switch:after{content:\"\";position:absolute;left:29px;top:11px;width:22px;height:22px;border-radius:50%;background:var(--selected-text)}.ds-switch:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.ds-switch:hover{filter:brightness(.93)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Standard three-destination bottom navigation.",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Home</button><button>Ledger</button><button>Sources</button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:8px;background:var(--shell)}.ds-nav button{font:600 16px system-ui;min-height:48px;border:0;border-radius:8px;background:transparent;color:var(--shell-muted)}.ds-nav button[aria-current]{background:var(--selected);color:var(--selected-text)}.ds-nav button:focus-visible{outline:3px solid var(--selected)}.ds-nav button:hover{filter:brightness(.93)}"
    },
    {
      "name": "Journey card",
      "kind": "card",
      "description": "Action and its sourced context.",
      "html": "<article class=\"ds-card\"><span>To do</span><h3>File your change of address</h3><p>Read the dates, then open the service.</p></article>",
      "css": ".ds-card{background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:20px;font:17px/1.5 system-ui}.ds-card span{font-size:15px;font-weight:700;color:var(--accent)}.ds-card h3{font-size:23px;line-height:1.25;letter-spacing:-.02em;margin:8px 0 12px}.ds-card p{margin:0}",
      "refersTo": "journey-card"
    },
    {
      "name": "Date cell",
      "kind": "chip",
      "description": "An event date with tabular numerals.",
      "html": "<time class=\"ds-date\" datetime=\"2026-11-01\">1 November</time>",
      "css": ".ds-date{display:inline-block;font:650 15px/1.5 system-ui;font-variant-numeric:tabular-nums;padding:2px 8px;border-radius:4px;background:var(--selected);color:var(--selected-text)}"
    },
    {
      "name": "Local boundary",
      "kind": "custom",
      "description": "A persistent inline outbound counter.",
      "html": "<div class=\"ds-net\"><span>Data leaving this phone</span><strong>0 requests</strong></div>",
      "css": ".ds-net{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--shell-muted);border-radius:8px;background:var(--shell);color:var(--shell-text);font:14px/1.3 system-ui}.ds-net span{color:var(--shell-muted)}.ds-net strong{font-size:16px;white-space:nowrap;font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "The local boundary",
    "overview": "A phone-first operating interface informed by Finnish swimming-hall wayfinding: clear public instructions, pool-tinted space, petrol framing and sharply legible selected states. The world supplies palette, type, density and one source-selection movement; navigation and controls remain familiar web controls.",
    "keyCharacteristics": [
      "Large task headings, direct actions and readable evidence.",
      "A committed colored shell, not isolated accent decoration.",
      "Flat work surfaces with visible state and a persistent boundary strip."
    ],
    "rules": [
      {
        "name": "The Boundary Rule",
        "body": "The shell and its readable outbound counter persist while the work area scrolls.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain standard web controls and keyboard affordances.",
      "Do keep the outbound counter visible, including during onboarding and settings.",
      "Do preserve strong contrast in both themes and long Finnish labels."
    ],
    "donts": [
      "Don’t add If branding; insurer names belong only in the relevant content cards.",
      "Don’t replace useful evidence or service links with decoration.",
      "Don’t use a physical-sign costume or novelty navigation."
    ]
  }
}
