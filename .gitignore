# datasets and large outputs stay out of git (PROTOCOL.md)
data/

# challenge materials from the organisers (PDFs), kept local only
materials/

# secrets
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# node
node_modules/
# build output (vite build in apps/web)
dist/

# xcode
DerivedData/
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# impeccable: the engine binary (~21 MB) is fetched on first run into
# ~/.impeccable, so it stays out of git; per-machine config and review
# captures stay local too
.claude/skills/impeccable/scripts/bin/
.agents/skills/impeccable/scripts/bin/
.impeccable/config.local.json
**/.impeccable/review/
**/.impeccable/hook.cache.json
**/.impeccable/questions/
.claude/settings.local.json
# impeccable's font index sits in a folder named data/; keep it
!.claude/skills/impeccable/scripts/data/
!.agents/skills/impeccable/scripts/data/

# synthetic phones are committed; everything else under data/ is not
!data/synthetic/
# model weights served locally (libs/embed/scripts/fetch-model.ts); never committed
apps/web/public/models/
libs/embed/models/
libs/embed/models-public/
# ONNX Runtime WASM files copied from node_modules (scripts/copy-ort.ts); never committed
apps/web/public/ort/
# TLS certificate and private key for phone mode (mkcert); the key must never be committed
apps/web/certs/

# cached open data for the offline demo is committed (WORK.md, libs/opendata)
!libs/opendata/data/
