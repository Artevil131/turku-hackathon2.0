{
  "name": "@ahead/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "phone": "vite build && vite preview --host --port 4443 --strictPort --mode phone",
    "assets": "node ../../libs/embed/scripts/fetch-model.ts --out public/models && node ../../scripts/copy-ort.ts",
    "serve": "vite build && vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@ahead/adapters": "workspace:*",
    "@ahead/contract": "workspace:*",
    "@ahead/detect": "workspace:*",
    "@ahead/embed": "workspace:*",
    "@ahead/journeys": "workspace:*",
    "@huggingface/transformers": "^4.3.1",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "vite": "^8.3.4"
  }
}
