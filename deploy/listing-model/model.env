# The listing model on chili (D-017, D-019). Change a value in a pull
# request; when it is merged to main, chili restarts the model with it
# within about five minutes (deploy/listing-model/README.md).
#
# Only these keys are read, values are letters, digits, dot, dash and
# underscore, and the artifact must already be on chili. Anything else in
# this file is ignored.

# Which weights. On chili now: qwen3_8_27b_nvfp4.ninfer (stock Qwen3.8-27B).
NINFER_ARTIFACT=qwen3_8_27b_nvfp4.ninfer
# The model name the API asks for (AHEAD_LISTING_MODEL in apps/api).
SERVED_NAME=qwen3.8-27b
# Longest prompt plus answer in tokens; ads are short, the card is shared.
NINFER_MAX_CONTEXT=131072
NINFER_KV_CAPACITY=131072
# Speculative decoding: mtp with 3 draft tokens works with this artifact.
NINFER_SPEC=mtp
NINFER_DRAFT_TOKENS=3
# 1 keeps image input on; screenshots need it.
NINFER_VISION=1
