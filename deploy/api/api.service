# systemd user unit on chili: apps/api from the deploy checkout that
# hackathon-model-sync keeps on main, in a Node container on the host
# network, listening on 127.0.0.1:8787 only. The tunnel (tunnel.service)
# is its only way in. Token hash: ~/.config/ahead/api.env (new-token.sh).
[Unit]
Description=turku-hackathon2.0 API (apps/api) for the listing model
After=network-online.target

[Service]
Environment=CHECKOUT=%h/deploy/turku-hackathon2.0
ExecStartPre=-/usr/bin/docker rm -f ahead-api
ExecStart=/usr/bin/docker run --rm --name ahead-api --network host \
  --memory=512m --memory-swap=512m --cpus=1 \
  -v ${CHECKOUT}:/app -w /app \
  --env-file %h/.config/ahead/api.env \
  -e AHEAD_API_HOST=127.0.0.1 -e AHEAD_API_PORT=8787 \
  -e AHEAD_LISTING_URL=http://127.0.0.1:8010 \
  node:22-slim sh -c 'mkdir -p node_modules/@ahead && for p in contract listing opendata; do ln -sfn ../../libs/$$p node_modules/@ahead/$$p; done && exec node apps/api/src/server.ts'
ExecStop=/usr/bin/docker stop ahead-api
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
